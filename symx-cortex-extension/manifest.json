{
  "manifest_version": 3,
  "name": "SYMX Cortex MVP (Development)",
  "version": "0.2.0",
  "description": "Read-only authorized Cortex collection to an explicitly configured test environment.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://logistics.amazon.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_popup": "options.html" },
  "content_scripts": [
    {
      "matches": ["https://logistics.amazon.com/operations/execution/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://logistics.amazon.com/operations/execution/*"],
      "js": ["collector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
